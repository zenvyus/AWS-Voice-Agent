{
  "name": "@airline-voice-agent/infra",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --config jest.config.ts",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.integration.ts",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.e2e.ts",
    "test:regression": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.regression.ts",
    "test:phase": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.e2e.ts --testPathPattern",
    "test:all": "jest --config jest.config.ts && cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.integration.ts && cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.e2e.ts",
    "lint": "eslint . --ext .ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "deploy:vectorstore": "cdk deploy AirlineVoiceAgent-VectorStore-${TARGET_ENV:-dev} --require-approval never",
    "deploy:intelligence": "cdk deploy AirlineVoiceAgent-Intelligence-${TARGET_ENV:-dev} --require-approval never",
    "deploy:phase5": "pnpm deploy:vectorstore && npx tsx scripts/create-aoss-index.ts ${TARGET_ENV:-dev} && pnpm deploy:intelligence"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-backup": "^3.1044.0",
    "@aws-sdk/client-bedrock-agent": "^3.1043.0",
    "@aws-sdk/client-cloudformation": "^3.1043.0",
    "@aws-sdk/client-cloudwatch": "^3.1043.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1044.0",
    "@aws-sdk/client-connect": "^3.1043.0",
    "@aws-sdk/client-dynamodb": "^3.1043.0",
    "@aws-sdk/client-ec2": "^3.1043.0",
    "@aws-sdk/client-ecr": "^3.1043.0",
    "@aws-sdk/client-ecs": "^3.1043.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1043.0",
    "@aws-sdk/client-elasticache": "^3.1043.0",
    "@aws-sdk/client-kinesis-video": "^3.1043.0",
    "@aws-sdk/client-kms": "^3.1043.0",
    "@aws-sdk/client-lambda": "^3.1043.0",
    "@aws-sdk/client-rds": "^3.1043.0",
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/client-sfn": "^3.1043.0",
    "@aws-sdk/client-sns": "^3.1044.0",
    "@aws-sdk/client-transcribe": "^3.1043.0",
    "@aws-sdk/credential-provider-node": "^3.972.39",
    "@smithy/protocol-http": "^5.3.14",
    "@smithy/signature-v4": "^5.3.14",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "aws-cdk": "^2.150.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
